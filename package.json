{
  "name": "cfb27-realignment-tool",
  "version": "0.2.0",
  "description": "Dynamic conference realignment tool for CFB27 dynasty saves",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "madden-franchise": "^4.3.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.slappey.realignmenttool",
    "productName": "Dynamic Conference Realignment Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!logos/**"
    ],
    "win": {
      "icon": "build/icon.ico"
    }
  }
}
